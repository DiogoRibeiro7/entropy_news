# .gitignore for entropy_news project

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
build/
dist/
*.egg-info/

# Virtual environment
.venv/

# PyTorch model files
*.pth

# Vocabulary pickle files
*.pkl

# Data
*.zip
*.gz
*.tar
*.tar.gz

# Output directories
output/

# OS-generated files
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Log files
*.log

# GloVe files
*.txt

# Poetry files
poetry.lock
