{
  "__inputs": [],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Entropy News Enterprise Training",
  "tags": ["entropy-news", "enterprise"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "graph",
      "title": "Trainer Throughput",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(entropy_trainer_samples_total[1m]))",
          "legendFormat": "Throughput"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "graph",
      "title": "Gradient Health",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(entropy_gradient_health)",
          "legendFormat": "Stability"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "graph",
      "title": "Checkpoint Latency",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(entropy_checkpoint_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "table",
      "title": "Node Health",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "entropy_orchestrator_node_status",
          "format": "table"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
